# Absolute site origin for canonical and hreflang. Example: https://example.com
VITE_SITE_URL=

# Cookieless analytics. Leave empty to keep analytics off.
# Plausible takes priority when its domain is set.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=
# Or Umami, if Plausible is empty:
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=

# Booking delivery. When empty, the form keeps the .ics, WhatsApp and mailto fallback.
VITE_FORMSPREE_ID=
